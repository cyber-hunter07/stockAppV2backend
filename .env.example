# MongoDB Atlas connection string. Use a dedicated, least-privilege application user.
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/stockManagementDB

# Generate a unique secret with at least 32 characters; never reuse the example value.
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters

# Groq API key (FREE) - AI Natural Language Query Bot - https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Gmail SMTP for Email Service (Alerts & Notifications) - FREE
# Create an App Password at https://myaccount.google.com/apppasswords
EMAIL_USER=youremail@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password

PORT=5000
NODE_ENV=development
# Comma-separated exact frontend origins. Production requires HTTPS origins.
CORS_ORIGIN=http://localhost:3000
# Set to the exact number of trusted reverse-proxy hops when hosted behind a proxy.
TRUST_PROXY_HOPS=0
# Scheduled backups and alert emails use this timezone.
SCHEDULE_TIMEZONE=Asia/Kolkata
